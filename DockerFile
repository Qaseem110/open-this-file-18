# Stage 1: Build the app using Bun
FROM oven/bun:alpine AS builder

WORKDIR /app

# Dependency files copy karein
COPY package.json bun.lock ./

# Dependencies install karein
RUN bun install --frozen-lockfile

# Baaki saara source code copy karein
COPY . .

# Production build generate karein
RUN bun run build

# Stage 2: Serve the static files using Nginx
FROM nginx:alpine

# TanStack Start / Nitro output folder copy karein
COPY --from=builder /app/.output/public /usr/share/nginx/html

# SPA Routing support ke liye Nginx config
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
